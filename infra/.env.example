# infra/.env.example
# 이 파일을 복사해서 infra/.env 를 만들고 값을 바꿔 쓰세요. (infra/.env 는 Git에 올라가지 않습니다)
#   cp infra/.env.example infra/.env
# 실제 비밀번호는 저장소·이슈·채팅방에 올리지 말고, 팀원에게는 개인 메시지로 전달하세요.

# PostgreSQL 15.19
POSTGRES_DB=stockshield
POSTGRES_USER=stockshield
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
# 메인 서버가 접속하는 앱 DB 계정. 백엔드가 처음 실행될 때 Flyway(V2)가 만든다. 비밀번호는 위와 다른 값으로 정한다.
# 비워 두면 메인 서버가 시작되지 않는다.
DB_APP_USER=stockshield_app
DB_APP_PASSWORD=change-me-app

# Redis 7.2.17
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# Kafka 3.7.2 (내 PC에서 접속하는 포트)
KAFKA_PORT=9092

# Kafka UI (선택, --profile tools 로 실행할 때만)
KAFKA_UI_PORT=8085

# 한국투자증권 Open API (시세 수집기에서 사용)
# KIS Developers에서 발급받은 App Key·App Secret을 넣으세요. 실제 증권 계좌와 연결된 값이라 절대 공유·커밋하지 마세요.
# KIS_ENV: real(실전투자) 또는 vts(모의투자). 발급받은 키 종류와 같아야 합니다.
KIS_ENV=vts
KIS_APP_KEY=
KIS_APP_SECRET=
# 접속 주소 (KIS Developers 공식 문서에서 최신 값 확인)
#   실전: REST https://openapi.koreainvestment.com:9443   웹소켓 ws://ops.koreainvestment.com:21000
#   모의: REST https://openapivts.koreainvestment.com:29443  웹소켓 ws://ops.koreainvestment.com:31000
KIS_REST_URL=https://openapivts.koreainvestment.com:29443
KIS_WS_URL=ws://ops.koreainvestment.com:31000
# 접근 토큰·웹소켓 접속키는 실행 중에 발급받아 Redis에 저장합니다. 여기에 넣지 않습니다.

# 시연 모드 (수집기와 메인 서버). true면 장 운영 시간 밖에도 저장된 시세를 재생해 시연한다 (MKT_TICK_001 #2)
DEMO_MODE=false

# 인증 코드 메일 발송 (메인 서버). 팀 전용 Gmail 앱 비밀번호는 담당자(조성우)에게 개인 메시지로 받는다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT 서명 키 (메인 서버). 32바이트 이상 임의 문자열
JWT_SECRET=

# 내부 API 토큰 (GET /api/v1/internal/reconcile/status 의 X-Internal-Token).
# 비어 있으면 내부 API는 모든 요청을 거절한다. reconcile.yml은 같은 값을 GitHub Secrets에서 읽는다.
INTERNAL_TOKEN=

# 화면 주소 (REST CORS와 WebSocket 허용 Origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gemini API (AI 서버: 뉴스 요약, 탐지 사유 설명). Google AI Studio에서 발급, 절대 커밋하지 않는다.
GEMINI_API_KEY=
